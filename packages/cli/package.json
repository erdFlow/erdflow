{
  "name": "erdflow",
  "version": "0.1.0",
  "description": "Local-first database schema IDE — detect Prisma, DBML, or SQL schemas and open an interactive ERD in the browser",
  "license": "MIT",
  "author": "abhimanyujangid",
  "keywords": [
    "erd",
    "database",
    "schema",
    "prisma",
    "dbml",
    "sql",
    "diagram",
    "entity-relationship"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdFlow/erdflow.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/erdFlow/erdflow#readme",
  "bugs": {
    "url": "https://github.com/erdFlow/erdflow/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": "./dist/cli.js",
  "files": [
    "dist/cli.js",
    "dist/public",
    "README.md"
  ],
  "scripts": {
    "build": "pnpm --filter web build && tsup && rm -rf dist/public && cp -R public dist/public && chmod +x dist/cli.js",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@prisma/internals": "^6.19.0",
    "chokidar": "^4.0.3",
    "commander": "^14.0.3",
    "open": "^10.2.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@erdflow/core": "workspace:*",
    "@erdflow/layout": "workspace:*",
    "@erdflow/parser-dbml": "workspace:*",
    "@erdflow/parser-prisma": "workspace:*",
    "@erdflow/parser-sql": "workspace:*",
    "@types/node": "^24",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "tsup": "^8.5.0",
    "typescript": "~6"
  }
}
